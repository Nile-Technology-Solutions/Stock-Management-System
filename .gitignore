# ============================================================
# Stock Management System — .gitignore
# ============================================================

# ─── Dependencies ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# ─── Lock files (keep package-lock for reproducible builds) ─
# Uncomment the line below if you do NOT want to track it:
# package-lock.json

# ─── Production builds ──────────────────────────────────────
dist/
build/
out/
build/Release/

# ─── Environment variables (NEVER commit secrets) ───────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production
# Keep .env.development and .env.production as examples
# but ignore any local overrides with a .local suffix

# ─── Documentation ──────────────────────────────────────────
# Ignore all markdown files by default
*.md
# Specifically allow README.md files
!README.md
!**/README.md

# ─── Internal data / spec files ─────────────────────────────
data/
api_spec.yaml
frontend-template/

# ─── Agent / AI tooling directories ─────────────────────────
.kiro/
.antigravity/
.agent/
.gemini/

# ─── Stray/accidental files ──────────────────────────────────
tatus

# ─── IDE and editor files ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.vite/

# ─── OS generated files ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log

# ─── Runtime data ───────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ─── Test coverage ──────────────────────────────────────────
coverage/
*.lcov

# ─── Temporary folders ──────────────────────────────────────
tmp/
temp/

# ─── Cache directories ──────────────────────────────────────
.cache/
.parcel-cache/
.next/
.nuxt/

# ─── Database files ─────────────────────────────────────────
*.sqlite
*.db

# ─── Misc tooling ───────────────────────────────────────────
.npm
.eslintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.node_repl_history
*.tgz
.yarn-integrity