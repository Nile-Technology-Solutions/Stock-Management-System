{
  "info": {
    "name": "SMS - Full API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Stock Management System API Endpoints (Excluding Payments). Includes Auth, Addresses, Users, Stock, Production, Products, Orders, To-Do, News, and Reports."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "txRef",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
