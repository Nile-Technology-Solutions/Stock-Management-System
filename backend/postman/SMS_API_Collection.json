            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Abebe Kebede Updated\",\n  \"role\": \"SuperAdmin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/4"
