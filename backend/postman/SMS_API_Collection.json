    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Users - 403 Forbidden (Admin token, not SuperAdmin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users"
            },
            "description": "Login as 'admin' first, then try this - should get 403"
          }
        },
        {
          "name": "Users - 409 Duplicate Username",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate User\",\n  \"username\": \"superadmin\",\n  \"password\": \"test123456\",\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users"
            }
          }
        },
        {
          "name": "Users - 404 Not Found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/9999"
            }
          }
        },
        {
          "name": "Production - 400 Invalid Progress (>100)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "categoryId",
                  "value": "2",
                  "type": "text"
                },
                {
                  "key": "progressPercentage",
                  "value": "150",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/production"
            }
          }
        },
        {
          "name": "Production - 400 Invalid Status Enum",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "categoryId",
