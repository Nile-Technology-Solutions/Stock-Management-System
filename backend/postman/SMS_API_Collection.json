    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "initiate"
              ]
            }
          }
        },
        {
          "name": "Payment Callback",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/callback?trx_ref={{txRef}}&status=success",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "callback"
              ],
              "query": [
                {
                  "key": "trx_ref",
                  "value": "{{txRef}}"
                },
                {
                  "key": "status",
                  "value": "success"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txRef\": \"{{txRef}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "verify"
              ]
            }
          }
        },
        {
          "name": "Get Payment By OrderId",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{orderId}}"
              ]
            }
          }
        }
      ]
    }
  ]
