          }
        },
        {
          "name": "PUT - Update User Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newPassword456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/4"
            }
          }
        },
        {
          "name": "DELETE - Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/4"
            }
          }
        },
        {
          "name": "POST - Create Customer User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sara Hailu\",\n  \"username\": \"sara_customer\",\n  \"password\": \"cust12345\",\n  \"role\": \"Customer\"\n}"
            },
