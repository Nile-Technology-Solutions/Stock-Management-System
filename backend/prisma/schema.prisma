generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────
// User & Role
// ────────────────────────────────────────────────
model User {
  id             Int      @id @default(autoincrement())
  fullName       String
  username       String   @unique
  password       String // hashed
  role           UserRole @default(Customer)
  phone          String?  @unique
  profilePicture String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses   Address[]
  orders      Order[]
  todoItems   TodoItem[]
  newsPosts   NewsPost[]
  preferences UserPreferences?
}

enum UserRole {
  SuperAdmin
  Admin
  Customer
}

// ────────────────────────────────────────────────
// Address
// ────────────────────────────────────────────────
model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  street    String
  city      String
  state     String?
  country   String   @default("Ethiopia")
  zipCode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

// ────────────────────────────────────────────────
// Category (dynamic, with optional sub-categories)
// ────────────────────────────────────────────────
model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  parentId    Int?

  parent            Category?          @relation("CategoryToSubCategory", fields: [parentId], references: [id])
  subCategories     Category[]         @relation("CategoryToSubCategory")
  stockMaterials    StockMaterial[]
  productionRecords ProductionRecord[]
  finishedProducts  FinishedProduct[]
}

// ────────────────────────────────────────────────
// Stock Material
// ────────────────────────────────────────────────
model StockMaterial {
  id          Int            @id @default(autoincrement())
  name        String
  quantity    Int            @default(0)
  color       String?
  size        String?
  thickness   String?
  laminated   Boolean        @default(false)
  origin      MaterialOrigin
  typeNote    String?
  categoryId  Int?
  lastUpdated DateTime       @updatedAt
  createdAt   DateTime       @default(now())

  category Category?                 @relation(fields: [categoryId], references: [id])
  usages   ProductionMaterialUsage[]
}

enum MaterialOrigin {
  Local
  Imported
}

// ────────────────────────────────────────────────
// Photo (separate FKs for each parent entity)
// ────────────────────────────────────────────────
model Photo {
  id                 Int      @id @default(autoincrement())
  url                String
  description        String?
  productionRecordId Int?
  finishedProductId  Int?
  newsPostId         Int?
  uploadedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  productionRecord ProductionRecord? @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  finishedProduct  FinishedProduct?  @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
  newsPost         NewsPost?         @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// Production Tracking
// ────────────────────────────────────────────────
model ProductionRecord {
  id                 Int              @id @default(autoincrement())
  orderId            Int?             @unique
  categoryId         Int
  title              String?
  status             ProductionStatus @default(UnderProcess)
  progressPercentage Int              @default(0)
  startedDate        DateTime         @db.Date
  submittingDate     DateTime?        @db.Date
  workInstructions   String?
  paymentNote        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  order          Order?                    @relation(fields: [orderId], references: [id])
  category       Category                  @relation(fields: [categoryId], references: [id])
  materialUsages ProductionMaterialUsage[]
  photos         Photo[]
}

model ProductionMaterialUsage {
  id                 Int      @id @default(autoincrement())
  productionRecordId Int
  stockMaterialId    Int
  quantityUsed       Int
  createdAt          DateTime @default(now())

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  stockMaterial    StockMaterial    @relation(fields: [stockMaterialId], references: [id])
}

enum ProductionStatus {
  UnderProcess
  Completed
  Rejected
}

// ────────────────────────────────────────────────
// Finished Products (Showcase)
// ────────────────────────────────────────────────
model FinishedProduct {
  id            Int      @id @default(autoincrement())
  name          String
  categoryId    Int
  color         String
  stockQuantity Int      @default(0)
  price         Decimal? @db.Decimal(10, 2)
  description   String?
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  photos   Photo[]
  orders   Order[]
}

// ────────────────────────────────────────────────
// Orders & Payments
// ────────────────────────────────────────────────
model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  deliveryAddressId Int?
  productId         Int?
  productName       String
  quantity          Int
  customNotes       String?
  status            OrderStatus @default(OrderSubmitted)
  totalPrice        Decimal?    @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  deliveryAddress  Address?          @relation(fields: [deliveryAddressId], references: [id])
  product          FinishedProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  payments         Payment[]
  productionRecord ProductionRecord?
}

enum OrderStatus {
  OrderSubmitted
  PaymentConfirmed
  UnderProcess
  Completed
  Cancelled
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(Pending)
  transactionRef String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  Chapa
  Telebirr
}

enum PaymentStatus {
  Pending
  Completed
  Failed
}

// ────────────────────────────────────────────────
// To-Do & News
// ────────────────────────────────────────────────
model TodoItem {
  id          Int      @id @default(autoincrement())
  userId      Int?
  day         WeekDay
  task        String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

enum WeekDay {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
}

model NewsPost {
  id          Int        @id @default(autoincrement())
  authorId    Int?
  title       String
  content     String
  status      NewsStatus @default(Published)
  publishDate DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User?   @relation(fields: [authorId], references: [id])
  photos Photo[]
}

enum NewsStatus {
  Draft
  Published
  Archived
}

// ────────────────────────────────────────────────
// User Preferences
// ────────────────────────────────────────────────
model UserPreferences {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  orderUpdates       Boolean  @default(true)
  promotionalEmails  Boolean  @default(false)
  newsletter         Boolean  @default(false)
  language           String   @default("en")
  currency           String   @default("ETB")
  paymentMethod      String   @default("Chapa")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
