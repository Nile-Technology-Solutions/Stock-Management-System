generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  username  String   @unique
  password  String // Hashed password
  role      UserRole @default(Customer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  SuperAdmin
  Admin
  Customer
}
// ===================== STOCK MODULE =====================
model StockMaterial {
  id          Int            @id @default(autoincrement())
  name        String
  quantity    Int
  color       String
  size        String
  thickness   String
  laminated   Boolean
  origin      MaterialOrigin
  typeNote    String?
  lastUpdated DateTime       @updatedAt
  createdAt   DateTime       @default(now())
}

enum MaterialOrigin {
  Local
  Imported
}

// ===================== PRODUCTION =====================
model ProductionRecord {
  id                 Int              @id @default(autoincrement())
  category           ProductCategory
  status             ProductionStatus @default(UnderProcess)
  progressPercentage Int
  startedDate        DateTime         @db.Date
  submittingDate     DateTime?        @db.Date
  workInstructions   String?
  paymentNote        String?
  photos             String[] // Array of photo URLs
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum ProductionStatus {
  UnderProcess
  Completed
  Rejected
}

// ===================== FINISHED PRODUCTS (SHOWCASE) =====================
model FinishedProduct {
  id          Int             @id @default(autoincrement())
  category    ProductCategory
  photos      String[]
  color       String          // Changed back to String
  amount      Int
  price       Float
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum ProductCategory {
  Bed
  Door
  Table
  Cabinet
  Other
}

// ===================== ORDERS & PAYMENTS =====================
model Order {
  id          Int         @id @default(autoincrement())
  productName String
  quantity    Int
  clientName  String
  phone       String
  address     String?
  status      OrderStatus @default(OrderSubmitted)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  Payment     Payment[]
}

enum OrderStatus {
  OrderSubmitted
  PaymentConfirmed
  UnderProcess
  Completed
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  amount         Float
  method         PaymentMethod
  status         String        @default("Pending")
  transactionRef String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  Order          Order         @relation(fields: [orderId], references: [id])
}

enum PaymentMethod {
  Chapa
  Telebirr
}

// ===================== TO-DO & NEWS =====================
model TodoItem {
  id          Int      @id @default(autoincrement())
  day         WeekDay
  task        String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum WeekDay {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
}

model NewsPost {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  status      String   @default("Published")
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}